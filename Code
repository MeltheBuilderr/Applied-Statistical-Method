# TASK 3
set.seed(seed)
size <- c(5,30,200)
random_sample <- 5000

sample_means <- list()
sample_sds   <- list()

p_mean <- mean(population0$reaction_ms)
p_sd <- sqrt(mean((population0$reaction_ms - p_mean)^2))

for (n in size) {
  means <- numeric(random_sample)
  sds   <- numeric(random_sample)
  
  for (i in 1:random_sample) {
    x <- sample(population0$reaction_ms, size = n)
    means[i] <- mean(x)
    sds[i]   <- sd(x)}
  
  sample_means[[as.character(n)]] <- means
  sample_sds[[as.character(n)]]   <- sds}

sapply(sample_means, length) 
sapply(sample_means, mean) %>% round(2)
sapply(sample_means, sd) %>% round(2) 

