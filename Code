# Task 4
# Compute the CIs for mean sleep hours
sleep_mean <- mean(sample1$sleep_hours, na.rm = TRUE)
n_sleep <- sum(!is.na(sample1$sleep_hours))
sleep_se <- sd(sample1$sleep_hours, na.rm = TRUE)/sqrt(n_sleep)

upper_90 <- (sleep_mean + (1.65*sleep_se)) %>% round(2) 
lower_90 <- (sleep_mean - (1.65*sleep_se)) %>% round(2)

upper_95 <- (sleep_mean + (1.96*sleep_se)) %>% round(2) 
lower_95 <- (sleep_mean - (1.96*sleep_se)) %>% round(2)

upper_99 <- (sleep_mean + (2.58*sleep_se)) %>% round(2) 
lower_99 <- (sleep_mean - (2.58*sleep_se)) %>% round(2)

CIs_table <- data.frame(
  Confidence = c("90%", "95%", "99%"),
  Lower = c(lower_90, lower_95, lower_99),
  Upper = c(upper_90, upper_95, upper_99))

CIs_table$Width <- round(CIs_table$Upper - CIs_table$Lower, 2)

cat("\n== Task 4.1: CIs for mean sleep_hours ==\n")
print(CIs_table)

